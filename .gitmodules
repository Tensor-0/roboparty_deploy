# ⚠️ 三个 submodule 指向【自己的 fork】，不是上游 —— 它们的 dm10 分支上有
#    只存在于 fork 的提交。指上游要靠 GitHub 的 fork 网络共享对象才取得到
#    （隐式行为，断掉 fork 关系 —— leave fork network / 删掉重建 / 上游消失 —— 就没了）。
#    create_ap 和 camera 不指 fork：它们记录的指针本来就是上游的提交。
[submodule "inference"]
	path = src/inference
	url = https://github.com/Tensor-0/roboparty_inference.git
[submodule "motors"]
	path = src/motors
	url = https://github.com/Tensor-0/roboparty_motors.git
[submodule "imu"]
	path = src/imu
	url = https://github.com/Tensor-0/roboparty_imu.git
[submodule "create_ap"]
	path = tools/create_ap
	url = https://github.com/Roboparty/create_ap.git
[submodule "camera"]
	path = src/camera
	url = https://github.com/Roboparty/roboparty_camera
